//@version=5
// Gap Maker — shades the gap between one session's CLOSE and the next session's
// OPEN, draws the 50% midpoint (the key half-gap level), and flags the gap when
// price fills it.
//
// Gap basis (input):
//   Weekend       -> Friday's close  -> the new week's (Sunday) open   (DEFAULT)
//   Session (RTH) -> the session's close -> next session open (0930-1600 = cash)
//
// Weekend detection is robust: futures don't print bars over the weekend, so the
// first bar after a >20h break IS the weekend open, and the bar before it is
// Friday's close. No request.security, no alignment quirks.
//
// Green box = gap up · Red box = gap down · gray = filled · dashed line = 50%.
// Paste into TradingView's Pine Editor -> Add to chart. Use an intraday chart.
indicator("Gap Maker", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ---------------- Inputs ----------------
gapMode   = input.string("Weekend", "Gap basis", options=["Weekend", "Session (RTH)"])
breakHrs  = input.float(20.0, "Weekend = bar gap longer than (hours)",
   tooltip="Weekend closes are ~48h; daily breaks ~1h. 20h cleanly isolates weekends & holidays.")
sess      = input.session("0930-1600", "RTH session (Session mode only)")
tz        = input.string("America/New_York", "Timezone")
minGap    = input.float(0.0, "Min gap size (points)", minval=0)
showMid   = input.bool(true,  "Show 50% midpoint line")
fillAt50  = input.bool(false, "Count gap 'filled' at 50% (else full close)")
extendR   = input.bool(true,  "Extend gap until filled")
hideFill  = input.bool(false, "Remove gap once filled")
showLbl   = input.bool(true,  "Show gap size label")
upCol     = input.color(color.new(color.lime, 80), "Gap up fill")
dnCol     = input.color(color.new(color.red, 80),  "Gap down fill")
fillCol   = input.color(color.new(color.gray, 85), "Filled color")
midCol    = input.color(color.yellow, "50% line color")
maxActive = input.int(200, "Max active (unfilled) gaps", minval=1)

// ---------------- Gap event / open / prior close ----------------
// Session (RTH) path
inSess = not na(time(timeframe.period, sess, tz))
isSessOpen = inSess and not inSess[1]
var float lastSessClose = na

// Weekend path: a bar-to-bar time jump longer than breakHrs = a weekend/holiday open
breakMs = time - nz(time[1], time)
isWeekendOpen = not na(time[1]) and breakMs > breakHrs * 3600.0 * 1000.0

bool  isNewGap = false
float gO  = na
float gPC = na
if gapMode == "Session (RTH)"
    isNewGap := isSessOpen and not na(lastSessClose)
    gO  := open
    gPC := lastSessClose
else
    isNewGap := isWeekendOpen
    gO  := open
    gPC := close[1]

// ---------------- Active-gap state ----------------
var gBox    = array.new_box()
var gFill   = array.new_float()   // price that "fills" the gap (close or 50%)
var gUp     = array.new_bool()
var gLbl    = array.new_label()   // gap-size label
var gMid    = array.new_line()    // 50% line
var gMidLbl = array.new_label()   // 50% price label

// ---------------- Create a gap ----------------
if isNewGap and not na(gPC)
    o  = gO
    pc = gPC
    gsize = math.abs(o - pc)
    if gsize >= minGap and o != pc
        up  = o > pc
        top = math.max(o, pc)
        bot = math.min(o, pc)
        mid = (o + pc) / 2.0
        fillLvl = fillAt50 ? mid : pc
        b = box.new(bar_index, top, bar_index + 1, bot,
           border_color=color.new(up ? color.lime : color.red, 40),
           bgcolor = up ? upCol : dnCol)
        label lb = na
        if showLbl
            lb := label.new(bar_index, up ? top : bot,
               (up ? "Gap Up " : "Gap Dn ") + str.tostring(gsize, format.mintick),
               style = up ? label.style_label_down : label.style_label_up,
               color=color.new(color.gray, 25), textcolor=color.white, size=size.small)
        line ml = na
        label mlb = na
        if showMid
            ml  := line.new(bar_index, mid, bar_index + 1, mid, color=midCol, width=1, style=line.style_dashed)
            mlb := label.new(bar_index, mid, "50% " + str.tostring(mid, format.mintick),
               style=label.style_label_left, color=color.new(midCol, 70), textcolor=midCol, size=size.small)
        array.push(gBox, b)
        array.push(gFill, fillLvl)
        array.push(gUp, up)
        array.push(gLbl, lb)
        array.push(gMid, ml)
        array.push(gMidLbl, mlb)
        if array.size(gBox) > maxActive
            box.delete(array.shift(gBox))
            array.shift(gFill)
            array.shift(gUp)
            l0 = array.shift(gLbl)
            if not na(l0)
                label.delete(l0)
            m0 = array.shift(gMid)
            if not na(m0)
                line.delete(m0)
            ml0 = array.shift(gMidLbl)
            if not na(ml0)
                label.delete(ml0)

// ---------------- Extend / fill-check ----------------
if array.size(gBox) > 0
    for i = array.size(gBox) - 1 to 0
        b   = array.get(gBox, i)
        fl  = array.get(gFill, i)
        up  = array.get(gUp, i)
        ml  = array.get(gMid, i)
        mlb = array.get(gMidLbl, i)
        filled = up ? (low <= fl) : (high >= fl)
        if filled
            if hideFill
                box.delete(b)
                l = array.get(gLbl, i)
                if not na(l)
                    label.delete(l)
                if not na(ml)
                    line.delete(ml)
                if not na(mlb)
                    label.delete(mlb)
            else
                box.set_bgcolor(b, fillCol)
                box.set_border_color(b, color.new(color.gray, 50))
                box.set_right(b, bar_index)
                if not na(ml)
                    line.set_x2(ml, bar_index)
            array.remove(gBox, i)
            array.remove(gFill, i)
            array.remove(gUp, i)
            array.remove(gLbl, i)
            array.remove(gMid, i)
            array.remove(gMidLbl, i)
        else if extendR
            box.set_right(b, bar_index + 1)
            if not na(ml)
                line.set_x2(ml, bar_index + 1)
            if not na(mlb)
                label.set_x(mlb, bar_index)

// keep the session close current (used by Session mode)
if inSess
    lastSessClose := close
